{
  "name": "playlist-tidy-for-spotify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keep owned Spotify playlists ordered newest-added first.",
  "license": "GPL-3.0-only",
  "copyright": "Copyright (C) 2026 AlbiDR",
  "author": "AlbiDR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbiDR/Playlist-Tidy-for-Spotify.git"
  },
  "bugs": {
    "url": "https://github.com/AlbiDR/Playlist-Tidy-for-Spotify/issues"
  },
  "homepage": "https://albidr.github.io/Playlist-Tidy-for-Spotify/",
  "scripts": {
    "build": "npm run build:web && npm run build:cli",
    "build:cli": "tsc -p config/tsconfig.cli.json",
    "build:web": "vite build --config config/vite.config.ts",
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "lint": "eslint --config config/eslint.config.js .",
    "license:fix": "node scripts/verify-license-headers.mjs --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project config/tsconfig.json --noEmit",
    "verify": "npm run verify:licenses && npm run verify:contributors && npm run typecheck && npm run lint && npm test && npm run build",
    "verify:contributors": "node scripts/verify-contributors.mjs",
    "verify:licenses": "node scripts/verify-license-headers.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
