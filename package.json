{
  "name": "playlist-tidy-for-spotify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keep owned Spotify playlists ordered newest-added first.",
  "license": "GPL-3.0-only",
  "copyright": "Copyright (C) 2026 AlbiDR",
  "author": "AlbiDR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbiDR/PlaylistTidy.git"
  },
  "bugs": {
    "url": "https://github.com/AlbiDR/PlaylistTidy/issues"
  },
  "homepage": "https://albidr.github.io/PlaylistTidy/",
  "scripts": {
    "build": "npm run clean && npm run build:web && npm run build:cli",
    "build:cli": "tsc -p config/tsconfig.cli.json",
    "build:web": "npm run generate:web-assets && vite build --config config/vite.config.ts && node scripts/finalize-web-build.ts && node scripts/sanitize-built-typography.ts && node scripts/verify-web-quality.ts",
    "capture:readme": "node scripts/capture-readme.ts",
    "audit:web": "node scripts/audit-web.ts && node scripts/audit-user-journey.ts",
    "audit:dependencies": "npm audit --audit-level=high",
    "cli": "npm run build:cli && node dist-cli/interfaces/cli/main.js",
    "clean": "node scripts/clean.ts",
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "generate:web-assets": "node scripts/generate-web-assets.ts",
    "lint": "eslint --config config/eslint.config.ts .",
    "license:fix": "node scripts/verify-license-headers.ts --fix",
    "test": "vitest run --config config/vite.config.ts",
    "test:watch": "vitest --config config/vite.config.ts",
    "typecheck": "tsc --project config/tsconfig.json --noEmit",
    "verify": "npm run verify:licenses && npm run verify:contributors && npm run verify:typography && npm run typecheck && npm run lint && npm test && npm run build",
    "verify:contributors": "node scripts/verify-contributors.ts",
    "verify:deployment": "node scripts/verify-deployment.ts",
    "verify:licenses": "node scripts/verify-license-headers.ts",
    "verify:typography": "node scripts/verify-typography.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "jiti": "^2.2.0",
    "playwright": "^1.56.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
